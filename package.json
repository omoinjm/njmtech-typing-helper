{
  "name": "njmtech-typing-helper",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "wxt apps/extension",
    "dev:firefox": "wxt apps/extension -b firefox",
    "dev:worker": "cd apps/worker && wrangler dev",
    "build": "pnpm build:extension && pnpm build:worker",
    "build:extension": "wxt build apps/extension && wxt build apps/extension -b firefox",
    "build:worker": "cd apps/worker && wrangler deploy --dry-run --outdir dist",
    "deploy": "cd apps/worker && wrangler deploy",
    "typecheck": "tsc -p apps/extension && tsc -p apps/worker",
    "test": "vitest run --config apps/extension/vitest.config.ts && vitest run --config apps/worker/vitest.config.ts",
    "test:extension": "wxt build apps/extension && playwright test --config apps/extension/playwright.config.ts",
    "package:chrome": "wxt zip apps/extension -b chrome",
    "package:edge": "wxt zip apps/extension -b edge",
    "package:firefox": "wxt zip apps/extension -b firefox",
    "icons": "node apps/extension/scripts/render-icons.mjs",
    "postinstall": "wxt prepare apps/extension"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "hono": "^4.13.13"
  }
}
