# .env — NOT committed (see .gitignore). Copy this file to .env and fill in
# real values. Used for local `wrangler` commands (deploy) via an API token
# instead of an interactive `wrangler login` session, which can expire. Same
# auth mechanism .github/workflows/deploy.yml uses in CI.
#
# Create a token at: Cloudflare dashboard → My Profile → API Tokens →
# Create Token → "Edit Cloudflare Workers" template.
CLOUDFLARE_API_TOKEN=REPLACE_WITH_YOUR_API_TOKEN

# Optional — found in the Cloudflare dashboard sidebar on Workers & Pages.
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_YOUR_ACCOUNT_ID

# Optional — point the extension at a local Worker (`pnpm dev:worker`).
# Read by WXT at build time.
# WXT_API_URL=http://localhost:8787/api/v1
